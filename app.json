{
  "expo": {
    "name": "student-guardian-app",
    "slug": "student-guardian-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_logo.png",
    "scheme": "studentguardianapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app_logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050D1C",
        "foregroundImage": "./assets/images/app_logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/app_logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/app_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050D1C",
          "image": "./assets/images/app_logo.png",
          "imageWidth": 90
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "403badd6-51fe-470a-8035-cb223cf84e2e"
      }
    }
  }
}
